{
  "mcpServers": {
    "ida-pro": {
      "type": "remote",
      "transport": "streamable-http",
      "url": "http://127.0.0.1:13337/mcp",
      "lifecycle": "lazy",
      "enabled": true
    },
    "firefox": {
      "type": "stdio",
      "command": "node",
      "args": [
        "~/.pi/agent/integrations/firefox/firefox-bidi-mcp.mjs"
      ],
      "env": {
        "FIREFOX_BIDI_PORT": "9222"
      },
      "lifecycle": "lazy",
      "enabled": true
    },
    "google-workspace": {
      "type": "stdio",
      "command": "/home/artu/.local/bin/bws",
      "args": [
        "run",
        "--",
        "/home/artu/.local/bin/uvx",
        "workspace-mcp",
        "--single-user",
        "--tools",
        "docs",
        "drive"
      ],
      "env": {
        "BWS_ACCESS_TOKEN": "!python3 -c 'import secretstorage as s;b=s.dbus_init();print(next((i.get_secret().decode() for i in s.search_items(b,{\"service\":\"bws-mcp\",\"account\":\"access-token\"})),\"\"),end=\"\")'",
        "WORKSPACE_MCP_CREDENTIALS_DIR": "/home/artu/.config/google-workspace-mcp/credentials",
        "OAUTHLIB_INSECURE_TRANSPORT": "1"
      },
      "lifecycle": "lazy",
      "enabled": true
    }
  }
}